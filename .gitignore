# Generated by the upstream installer; contains secrets (.env)
n8n/
# Snapshots contain the data volume and .env
n8n-backups/
# Append-only operations log
n8nctl.log
exports/
# Generated by templates-api/build.py from workflows tagged "template"
templates-api/data/
templates-api/.build-*
# n8n.io templates stored by the gallery server: community content, not ours to publish
templates-api/library/
# AI Assistant chats saved as Markdown by n8nctl.sh chats save (private)
chats/
