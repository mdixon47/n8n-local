<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.n8nctl.backup</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Opens the n8nctl Backup app (launchd/n8nctl-backup.applescript), which runs
         ./n8nctl.sh -y backup and backups --prune 14. A plain /bin/bash job is
         refused access to the external drive; the app can be allowed once. -->
    <string>/usr/bin/open</string>
    <string>-W</string>
    <string>-g</string>
    <string>/Users/malikdixon/Applications/n8nctl Backup.app</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>NO_COLOR</key>
    <string>1</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/malikdixon/Library/Logs/n8nctl-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/malikdixon/Library/Logs/n8nctl-backup.log</string>
</dict>
</plist>
