#!/usr/bin/env bash
# stub docker for n8nctl smoke tests
V="$STUB_STATE/volumes"
echo "docker $*" >> "$STUB_STATE/docker.calls"
case "$1" in
  --version) echo "Docker version 27.1.0, build abc"; exit 0 ;;
  info) exit 0 ;;
  volume)
    case "$2" in
      ls) ls -1 "$V" 2>/dev/null; exit 0 ;;
      rm) rm -rf "${V:?}/${3:?}"; exit 0 ;;
    esac ;;
  exec)
    # docker exec -u node <id> <cmd...>; container paths map to $STUB_STATE/container/...
    shift; [[ "$1" == "-u" ]] && shift 2; shift   # drop -u node and the container id
    C="$STUB_STATE/container"
    case "$1" in
      n8n)
        out=""; sep=0
        for a in "$@"; do case "$a" in --output=*) out="${a#--output=}" ;; --separate) sep=1 ;; esac; done
        [[ -n "$out" ]] || { echo "stub: no --output" >&2; exit 1; }
        if (( sep )); then mkdir -p "$C$out"; printf '{"name":"a"}' > "$C$out/a.json"; printf '{"name":"b"}' > "$C$out/b.json"
        else mkdir -p "$(dirname "$C$out")"; printf '[{"name":"a"},{"name":"b"}]' > "$C$out"; fi
        exit 0 ;;
      rm) rm -rf "${C:?}$3"; exit 0 ;;
      # a path listed in $STUB_STATE/dead behaves like a dead bind mount
      ls) if grep -qxF "$2" "$STUB_STATE/dead" 2>/dev/null; then echo "ls: $2: Bad file descriptor" >&2; exit 1; fi; exit 0 ;;
    esac; echo "stub docker exec: unhandled $*" >&2; exit 1 ;;
  inspect)
    # docker inspect -f FORMAT <id>: bind mounts from $STUB_STATE/mounts, health from $STUB_STATE/health
    case "$3" in
      *.Mounts*) cat "$STUB_STATE/mounts" 2>/dev/null; exit 0 ;;
      *.Health*) cat "$STUB_STATE/health" 2>/dev/null; exit 0 ;;
      *.Name*) echo "/n8n-n8n-1"; exit 0 ;;
    esac ;;
  cp)
    src="${2#*:}"; cp -R "$STUB_STATE/container$src" "$3"; exit 0 ;;
  run)
    # parse -v src:dst[:ro] mounts, then run the trailing command with paths mapped
    shift; declare -a mounts=(); cmd=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --rm) ;;
        -v) mounts+=("$2"); shift ;;
        alpine:*) shift; cmd=("$@"); break ;;
      esac; shift
    done
    data=""; backup=""
    for m in "${mounts[@]}"; do
      src="${m%%:*}"; rest="${m#*:}"; dst="${rest%%:*}"
      case "$dst" in /data) data="$V/$src"; mkdir -p "$data" ;; /backup) backup="$src" ;; esac
    done
    if [[ "${cmd[0]}" == "sh" ]]; then script="${cmd[2]}"; else script="${cmd[*]}"; fi
    script="${script//\/data/$data}"; script="${script//\/backup/$backup}"
    bash -c "$script"; exit $? ;;
  compose)
    shift
    while [[ "$1" == "-f" ]]; do shift 2; done
    case "$1" in
      version) echo "2.29.7"; exit 0 ;;
      pull) exit 0 ;;
      up) mkdir -p "$V/n8n_n8n-data"; [[ ! -f "$V/n8n_n8n-data/database.sqlite" ]] && echo "v1" > "$V/n8n_n8n-data/database.sqlite"
          for a in "$@"; do [[ "$a" == "--no-start" ]] && exit 0; done
          touch "$STUB_STATE/running"; exit 0 ;;
      down) rm -f "$STUB_STATE/running"; for a in "$@"; do [[ "$a" == "-v" ]] && rm -rf "$V/n8n_n8n-data"; done; exit 0 ;;
      stop) rm -f "$STUB_STATE/running"; exit 0 ;;
      start) touch "$STUB_STATE/running"; exit 0 ;;
      ps) if [[ -f "$STUB_STATE/running" ]]; then
            for a in "$@"; do [[ "$a" == "-q" ]] && { echo "abc123"; exit 0; }; done
            echo "NAME        STATUS"; echo "n8n-n8n-1   running"
          fi; exit 0 ;;
      logs) echo "[stub] logs $*"; cat "$STUB_STATE/n8n.log" 2>/dev/null; exit 0 ;;
    esac ;;
esac
echo "stub docker: unhandled: $*" >&2; exit 1
